# Supabase 프로젝트 설정. 실제 값은 .env.local에 넣고 커밋하지 않는다.

# 프로젝트 URL과 브라우저에 노출되는 publishable key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 멀티플레이 방 상태(game_rooms)를 서버에서만 읽고 쓰기 위한 secret key.
# 클라이언트로 절대 내보내지 않는다(NEXT_PUBLIC_ 접두사를 붙이지 말 것).
SUPABASE_SECRET_KEY=your-secret-key
