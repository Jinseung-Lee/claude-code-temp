# Supabase 프로젝트 설정. 실제 값은 .env.local에 넣고 커밋하지 않는다.
#
# 이 파일 없이도 앱은 동작한다. 그때 방 상태는 서버 메모리에 보관되며,
# 서버 재시작이나 다중 인스턴스 환경에서는 진행 중인 방이 사라진다.
# 아래 값을 채우면 Supabase 영속 저장으로 자동 전환된다.

# 프로젝트 URL과 브라우저에 노출되는 publishable key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 멀티플레이 방 상태(game_rooms)를 서버에서만 읽고 쓰기 위한 secret key.
# 클라이언트로 절대 내보내지 않는다(NEXT_PUBLIC_ 접두사를 붙이지 말 것).
SUPABASE_SECRET_KEY=your-secret-key
